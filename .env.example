POSTGRES_DB=jr_labels
POSTGRES_USER=jr_labels
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://jr_labels:change-this-password@postgres:5432/jr_labels?schema=public
API_PORT=4000
WEB_ADMIN_PORT=3000
APP_ENV=development
ENABLE_DEMO_SEED=true
REQUIRE_AUTH=true
AUTH_TOKEN_SECRET=change-this-to-a-long-random-secret
COOKIE_SECURE=false

# Production guidance:
# APP_ENV=production
# ENABLE_DEMO_SEED=false
# REQUIRE_AUTH=true
# AUTH_TOKEN_SECRET must be a long random value and must remain stable across API container recreates.
# COOKIE_SECURE=true when served through HTTPS.
